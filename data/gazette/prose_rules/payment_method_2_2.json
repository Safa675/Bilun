        "payment_method_tr": "özel kuruluş günlük muayene sınırı — hekim×6 saat temel; hekim başı günlük 60, acil 90, triyaj kırmızı toplam 120 (112 Komuta Kontrol ile 120 aşılabilir); 700610/700611 her işlem için 1 muayene düşülür; sınır aşımı Kuruma faturalandırılamaz",
        "daily_visit_cap_basis": "physician_hours_x6",
        "daily_visit_cap_per_physician": 60,
        "emergency_daily_visit_cap": 90,
        "triage_red_total_daily_cap": 120,
        "komuta_kontrol_112_may_exceed_120": true,
        "transesophageal_echo_codes": [
          "700610",
          "700611"
