{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilun.local/schemas/drug_indication_prose.schema.json",
  "title": "SUT §4.2 drug indication and report prose",
  "description": "Endikasyon, rapor, ICD-10 and EK-4/A crosswalk rules for claim validation (Tier 3b corpus).",
  "type": "object",
  "required": ["rule_set_id", "title", "effective_date", "rules"],
  "additionalProperties": true,
  "properties": {
    "rule_set_id": { "type": "string", "const": "drug_indication_prose" },
    "title": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "coverage_note": { "type": "string" },
    "sut_anchors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "sut_section"],
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string" },
        "sut_section": { "type": "string" },
        "drug_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "icd10_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "icd10_ranges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "growth_hormone_continuation_protocol": { "type": "string", "enum": ["turner_somatropin_v1", "pediatric_gh_v1"] },
        "pediatric_gh_initiation_protocol": { "type": "string", "const": "pediatric_gh_initiation_v1" },
        "gh_initiation_pathways": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["standard", "neurosecretory_bioinactive", "organic_or_surgical", "sga_case_1", "sga_case_2"] } },
        "gh_patient_group": { "type": "string", "enum": ["pediatric", "adult"] },
        "gh_treatment_phase": { "type": "string", "enum": ["initiation", "continuation"] },
        "ckd_growth_hormone_protocol": { "type": "string", "enum": ["ckd_somatropin_v1"] },
        "mecasermin_source_scope": { "type": "string", "const": "mecasermin_laron_v1" },
        "mecasermin_source_authority": {
          "type": "object", "required": ["legal_valid_from", "known_as_of_dates", "coverage_kind"],
          "additionalProperties": false,
          "properties": {
            "legal_valid_from": { "type": "null" },
            "known_as_of_dates": { "type": "array", "uniqueItems": true, "minItems": 1,
              "items": { "type": "string", "format": "date" } },
            "coverage_kind": { "const": "verified_snapshot_dates_only" }
          }
        },
        "pws_continuation_protocol": { "type": "string", "enum": ["pws_somatropin_v1"] },
        "report_duration_by_phase": {
          "type": "object", "required": ["initiation", "continuation"], "additionalProperties": false,
          "properties": { "initiation": { "const": 3 }, "continuation": { "const": 6 } }
        },
        "report_required": { "type": "boolean" },
        "report_specialties": {
          "type": "array",
          "items": { "type": "string" }
        },
        "report_duration_months": { "type": "integer", "minimum": 1 },
        "prescriber_specialties": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inpatient_only": { "type": "boolean" },
        "encode_batch": { "type": "string" },
        "gate_b_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message_tr": { "type": "string" }
      }
    }
  }
}
