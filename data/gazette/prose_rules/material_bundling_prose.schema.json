{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilun.local/schemas/material_bundling_prose.schema.json",
  "title": "SUT §3.1–3.2 material bundling prose decision table",
  "description": "Aligned with payment_method_2_2.json and copay_general_1_8.json rule-set shape.",
  "type": "object",
  "required": ["rule_set_id", "title", "effective_date", "rules"],
  "additionalProperties": true,
  "properties": {
    "rule_set_id": { "type": "string", "const": "material_bundling_prose" },
    "title": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "coverage_note": { "type": "string" },
    "sut_anchors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "sut_section", "deontic", "condition", "action"],
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string" },
        "sut_section": { "type": "string" },
        "deontic": {
          "type": "string",
          "enum": [
            "NO_PAY",
            "MUST_NOT_BILL",
            "MUST_HAVE_CODE",
            "MUST_PAIR_PROCEDURE",
            "REGULATORY_ACTION"
          ]
        },
        "condition": { "$ref": "#/$defs/condition" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_name_any": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "material_code_missing": { "type": "boolean" },
        "requires_material_code": { "type": "boolean" },
        "material_not_in_ek3c": { "type": "boolean" },
        "material_not_in_ek3": { "type": "boolean" },
        "material_in_ek3c": { "type": "boolean" },
        "procedure_pairing_required": { "type": "boolean" },
        "titubb_uts_incomplete": { "type": "boolean" },
        "titubb_missing": { "type": "boolean" },
        "uts_missing": { "type": "boolean" },
        "procurement_record_incomplete": { "type": "boolean" },
        "procedure_not_reimbursed": { "type": "boolean" },
        "foreign_facility": { "type": "boolean" },
        "facility_procedure_restriction_violation": { "type": "boolean" },
        "diagnosis_bundled_no_separate_bill": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "required": ["material_outcome", "severity", "message_tr"],
      "additionalProperties": true,
      "properties": {
        "material_outcome": {
          "type": "string",
          "enum": ["no_pay", "must_not_bill_separately", "review_required"]
        },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message_tr": { "type": "string", "minLength": 1 }
      }
    }
  }
}
