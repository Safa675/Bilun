{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilun.local/schemas/material_bundling_prose.schema.json",
  "title": "SUT §3.1–3.2 material bundling prose decision table",
  "description": "Aligned with payment_method_2_2.json and copay_general_1_8.json rule-set shape.",
  "type": "object",
  "required": ["rule_set_id", "title", "effective_date", "rules"],
  "additionalProperties": true,
  "properties": {
    "rule_set_id": { "type": "string", "const": "material_bundling_prose" },
    "title": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "coverage_note": { "type": "string" },
    "sut_anchors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "sut_section", "deontic", "condition", "action"],
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string" },
        "sut_section": { "type": "string" },
        "deontic": {
          "type": "string",
          "enum": [
            "NO_PAY",
            "MUST_NOT_BILL",
            "MUST_HAVE_CODE",
            "MUST_PAIR_PROCEDURE",
            "MANDATORY",
            "REGULATORY_ACTION"
          ]
        },
        "condition": { "$ref": "#/$defs/condition" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_name_any": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "material_code_missing": { "type": "boolean" },
        "requires_material_code": { "type": "boolean" },
        "material_not_in_ek3c": { "type": "boolean" },
        "material_not_in_ek3": { "type": "boolean" },
        "material_in_ek3c": { "type": "boolean" },
        "procedure_pairing_required": { "type": "boolean" },
        "titubb_uts_incomplete": { "type": "boolean" },
        "titubb_missing": { "type": "boolean" },
        "uts_missing": { "type": "boolean" },
        "procurement_record_incomplete": { "type": "boolean" },
        "procedure_not_reimbursed": { "type": "boolean" },
        "foreign_facility": { "type": "boolean" },
        "facility_procedure_restriction_violation": { "type": "boolean" },
        "diagnosis_bundled_no_separate_bill": { "type": "boolean" },
        "separate_billing_not_authorized": { "type": "boolean" },
        "procurement_price_refs_insufficient": { "type": "boolean" },
        "medula_code_undefined_on_date": { "type": "boolean" },
        "barcode_sut_mismatch": { "type": "boolean" },
        "diagnosis_bundled_material_scope": { "type": "boolean" },
        "cross_branch_material_unauthorized": { "type": "boolean" },
        "ortez_protez_contract_billing_invalid": { "type": "boolean" },
        "maintenance_cost_exceeds_sut_cap": { "type": "boolean" },
        "protez_repair_documentation_incomplete": { "type": "boolean" },
        "warranty_maintenance_procedure_incomplete": { "type": "boolean" },
        "ortez_protez_maintenance_unverified": { "type": "boolean" },
        "ihale_dts_mandatory_fields_incomplete": { "type": "boolean" },
        "supplier_contract_pricing_path": { "type": "boolean" },
        "ek3c_inpatient_external_supply_invalid": { "type": "boolean" },
        "ek3c_list_price_missing": { "type": "boolean" },
        "ek3_quality_documentation_incomplete": { "type": "boolean" },
        "ek3c_miat_early_renewal_unauthorized": { "type": "boolean" },
        "ek3c_custom_order_billing_invalid": { "type": "boolean" },
        "ek3c_medical_appropriateness_incomplete": { "type": "boolean" },
        "ek3c_custom_garment_contract_invalid": { "type": "boolean" },
        "ek3c_force_majeure_renewal_claim": { "type": "boolean" },
        "ek3c_outpatient_material_scope": { "type": "boolean" },
        "inpatient_material_facility_supply_violation": { "type": "boolean" },
        "non_reimbursed_inpatient_patient_charge": { "type": "boolean" },
        "lab_material_separate_billing": { "type": "boolean" },
        "shared_consumable_wrong_branch_billing": { "type": "boolean" },
        "material_prescription_quantity_exceeded": { "type": "boolean" },
        "material_report_prescription_invalid": { "type": "boolean" },
        "material_invoice_documentation_incomplete": { "type": "boolean" },
        "diagnosis_package_material_unbundled": { "type": "boolean" },
        "emergency_uncontracted_facility_material": { "type": "boolean" },
        "unlisted_material_surcharge_billing": { "type": "boolean" },
        "wheelchair_dual_prescription_invalid": { "type": "boolean" },
        "outpatient_contract_center_supply_required": { "type": "boolean" },
        "child_growth_miat_renewal_claim": { "type": "boolean" },
        "facility_contract_material_supply_scope": { "type": "boolean" },
        "ismarlama_device_component_titubb_incomplete": { "type": "boolean" },
        "titubb_uts_barcode_documentation_missing": { "type": "boolean" },
        "disabled_veteran_ortez_protez_billing_review": { "type": "boolean" },
        "terror_victim_ortez_protez_documentation_incomplete": { "type": "boolean" },
        "material_prescription_correction_invalid": { "type": "boolean" },
        "device_return_application_deadline_missed": { "type": "boolean" },
        "material_effective_date_transition_scope": { "type": "boolean" },
        "ek3c_list_field_definition_scope": { "type": "boolean" },
        "ismarlama_licensed_center_supply_required": { "type": "boolean" },
        "ek3c_optional_appropriateness_consumable": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "required": ["material_outcome", "severity", "message_tr"],
      "additionalProperties": true,
      "properties": {
        "material_outcome": {
          "type": "string",
          "enum": ["no_pay", "must_not_bill_separately", "review_required"]
        },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "message_tr": { "type": "string", "minLength": 1 }
      }
    }
  }
}
