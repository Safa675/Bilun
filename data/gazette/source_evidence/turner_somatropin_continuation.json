          "has_struck_runs": false
        },
        {
          "docx_paragraph_index_zero_based": 4279,
          "text": "c) Boy uzunluğu 155 cm.’ ye ulaştığında.",
          "text_sha256": "62c61a163b3e977feafb1917174dbda2104a07ae5e0abb1d285552938b6669fd",
          "has_struck_runs": false
        },
        {
          "docx_paragraph_index_zero_based": 4280,
          "text": "ç) Kemik yaşı 14’ e ulaştığında.",
          "text_sha256": "89b3cb7c5d1545af9df3ef791a21e3c6f9b3237fdfeb4487b5bef741d6aa2f19",
          "has_struck_runs": false
