# ─────────────────────────────────────────────────────────────────────────────
# BILUN environment variables. Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (shared-password gate) ──────────────────────────────────────────────
# Required when exposing the app to anyone beyond localhost. Generate with:
#   python scripts/generate_auth_env.py <username> <password>
# When these are set, every request (frontend + backend) requires a valid
# session cookie obtained via /api/auth/login. When unset, auth fails CLOSED
# (401 / redirect to login) unless BILUN_AUTH_OPTIONAL=1 for local dev only.
BILUN_AUTH_OPTIONAL=0
BILUN_AUTH_USERNAME='bilun_admin'
BILUN_AUTH_PASSWORD=           # pbkdf2_sha256$... (the HASH, quoted — $ must not be expanded by shell)
BILUN_SESSION_SECRET=          # random 48+ char string; rotating it logs everyone out
# Tip: `python scripts/generate_auth_env.py <user> <pass>` prints ready-to-paste quoted lines.

# ── Backend bind ─────────────────────────────────────────────────────────────
# Default 127.0.0.1 (loopback) so the backend is reachable only through the
# Next.js /api rewrite, not directly from the network. Set to 0.0.0.0 only if
# you have a firewall/reverse-proxy restricting :8001 access.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=3000

# ── LLM (chatbot) ────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint (e.g. Alibaba Token Plan or OpenRouter).
# The chatbot is disabled (with a UI message) when LLM_API_KEY is absent.
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-0731
LLM_ENDPOINT=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Optional, OpenRouter reasoning models only: max | xhigh | high | medium | low | minimal | none.
# Reasoning tokens count against max_tokens, so a model that defaults to a high
# effort can spend the whole public output cap thinking and never answer. Use a
# value the model lists under reasoning.supported_efforts (GET /api/v1/models);
# an unsupported value makes the provider answer 400. Unset = no reasoning field.
# LLM_REASONING_EFFORT=low

# ── Startup ──────────────────────────────────────────────────────────────────
BILUN_STARTUP_POLICY=load-only
