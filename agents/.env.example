# Environment variables for the OpenHands employee agents.
# Copy to .env (gitignored) and fill in, OR pass via -e on the docker run command.
#
# The OpenHands app container does NOT automatically forward arbitrary env vars to the
# sandbox. For the sandbox to see Z_API_KEY / MEM0_* , they must be set on the
# openhands-app container AND auto-forwarded. agents.memory.load/save read them via
# os.environ.
#
# Recommended: set them in the openhands-app launch command:
#   -e Z_API_KEY=5b29... \
#   -e MEM0_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4 \
#   -e MEM0_LLM_MODEL=glm-4.6 \
# But CAUTION: this puts the key in the container env (visible via `docker inspect`).
# For production, use a secret file or OpenHands' OH_AGENT_SERVER_ENV JSON.

# Z.ai coding-plan API key (required for mem0 LLM fact extraction).
# Get from: https://z.ai platform (the coding-plan tier, NOT the OAuth token ZCode uses).
Z_API_KEY=

# Optional: override mem0 fact-extraction LLM when the Z coding plan / endpoint changes.
# Defaults match the current Z.ai OpenAI-compatible coding paas.
# MEM0_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# MEM0_LLM_MODEL=glm-4.6
# MEM0_LLM_PROVIDER=openai

# Optional: override the mem0 data dir (defaults to reports/agent/.mem0/ inside the repo).
# Useful for pointing at a persistent volume on the VPS.
# MEM0_DATA_DIR=/var/lib/bilun-mem0
